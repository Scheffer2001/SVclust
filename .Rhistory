library(Rcpp)
library(RcppArmadillo)
library(kernlab)
install.packages("kernlab")
install.packages("microbenchmark")
library(Rcpp)
library(RcppArmadillo)
library(kernlab)
library(microbenchmark)
library(ggplot2)
cppFunction(depends = "RcppArmadillo", '
NumericVector sigest_cpp(arma::mat x, double frac = 0.5) {
int m = x.n_rows;
int n = std::floor(frac * m);
if (n < 2) n = 2;
// Geradores de índices aleatórios (arma::randu usa o gerador interno do Armadillo)
arma::uvec index1 = arma::conv_to<arma::uvec>::from(arma::floor(arma::randu<arma::vec>(n) * m));
arma::uvec index2 = arma::conv_to<arma::uvec>::from(arma::floor(arma::randu<arma::vec>(n) * m));
arma::vec dists(n);
for(int i = 0; i < n; ++i) {
// Cálculo eficiente: norma quadrada da diferença de duas linhas
arma::rowvec diff = x.row(index1(i)) - x.row(index2(i));
dists(i) = arma::dot(diff, diff);
}
// Filtragem de zeros e cálculo de quantis via ordenação
arma::vec dists_nz = dists(arma::find(dists > 0));
arma::vec sorted_dists = arma::sort(dists_nz);
int n_nz = sorted_dists.n_elem;
double q90 = sorted_dists(std::min((int)std::floor(0.9 * n_nz), n_nz - 1));
double q50 = sorted_dists(std::min((int)std::floor(0.5 * n_nz), n_nz - 1));
double q10 = sorted_dists(std::min((int)std::floor(0.1 * n_nz), n_nz - 1));
NumericVector res = NumericVector::create(1.0/q90, 1.0/q50, 1.0/q10);
res.names() = CharacterVector::create("90%", "50%", "10%");
return res;
}')
set.seed(42)
n_rows <- 50000
n_cols <- 100
data_mat <- matrix(rnorm(n_rows * n_cols), ncol = n_cols)
res_r   <- sigest(data_mat, frac = 0.05, scaled = FALSE)
res_cpp <- sigest_cpp(data_mat, frac = 0.05)
print(list(Kernlab_sigest = res_r, Rcpp_sigest = res_cpp))
bm <- microbenchmark(
kernlab_R = sigest(data_mat, frac = 0.05, scaled = FALSE),
rcpp_cpp  = sigest_cpp(data_mat, frac = 0.05),
times = 15
)
print(bm)
print(bm)
print(list(Kernlab_sigest = res_r, Rcpp_sigest = res_cpp))
print(bm)
autoplot(bm) +
theme_minimal() +
labs(title = "Benchmark: Estimativa de Sigma (R vs C++)",
subtitle = paste("Base de Dados:", n_rows, "linhas x", n_cols, "colunas"),
x = "Implementação", y = "Tempo [log]")
sigest_simple_R <- function(x, frac = 0.5) {
m <- nrow(x)
n <- floor(frac * m)
index <- sample(1:m, n, replace = TRUE)
index2 <- sample(1:m, n, replace = TRUE)
dist <- rowSums((x[index, , drop=FALSE] - x[index2, , drop=FALSE])^2)
return(1 / median(dist[dist != 0]))
}
cppFunction(depends = "RcppArmadillo", '
double sigest_single_cpp(const arma::mat& x, double frac = 0.5) {
int m = x.n_rows;
int n = std::floor(frac * m);
arma::uvec idx1 = arma::conv_to<arma::uvec>::from(arma::floor(arma::randu<arma::vec>(n) * m));
arma::uvec idx2 = arma::conv_to<arma::uvec>::from(arma::floor(arma::randu<arma::vec>(n) * m));
arma::vec dists(n);
for(int i = 0; i < n; ++i) {
arma::rowvec diff = x.row(idx1(i)) - x.row(idx2(i));
dists(i) = arma::dot(diff, diff);
}
arma::vec dists_nz = dists(arma::find(dists > 0));
return 1.0 / arma::median(dists_nz);
}')
set.seed(123)
data_mat <- matrix(rnorm(500000 * 50), ncol = 50)
f_sample <- 0.5
res_kernlab <- sigest(data_mat, frac = f_sample, scaled = FALSE)[2]
res_simple  <- sigest_simple_R(data_mat, frac = f_sample)
res_cpp     <- sigest_single_cpp(data_mat, frac = f_sample)
print(c(Kernlab_Mediana = res_kernlab, R_Simples = res_simple, CPP_Single = res_cpp))
bm_final <- microbenchmark(
kernlab_completo = sigest(data_mat, frac = f_sample, scaled = FALSE),
R_simples        = sigest_simple_R(data_mat, frac = f_sample),
CPP_otimizado    = sigest_single_cpp(data_mat, frac = f_sample),
times = 20
)
print(bm_final)
print(bm_final)
