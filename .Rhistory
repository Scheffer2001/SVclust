frac_seq <- seq(0.05, 1, by = 0.05)
n_iterations <- 100
x_matrix <- as.matrix(iris[, 1:4])
results <- matrix(NA, nrow = n_iterations, ncol = length(frac_seq))
colnames(results) <- frac_seq
set.seed(42)
for (i in 1:n_iterations) {
for (j in seq_along(frac_seq)) {
results[i, j] <- kernlab::sigest(x = x_matrix, scaled = TRUE, frac = frac_seq[j])[2]
}
}
boxplot(results,
main = "Variation of sigest (Median Sigma) over 100 Trials",
xlab = "Fraction (frac)",
ylab = "Estimated Sigma",
col = "lightblue",
border = "darkblue",
pch = 20,
cex = 0.7)
boxplot(results,
main = "Variation of sigest (Median Sigma) over 100 Trials",
xlab = "Fraction (frac)",
ylab = "Estimated Sigma",
col = "lightblue",
border = "darkblue",
pch = 20,
cex = 0.7)
lines(colMeans(results), type = "b", col = "red", lwd = 2, pch = 19)
stdevs <- apply(results, 2, sd)
plot(frac_seq, stdevs, type = "b", pch = 19,
main = "Standard Deviation of Sigma Estimates",
xlab = "Frac", ylab = "Standard Deviation")
frac_seq <- seq(0.05, 1, by = 0.05)
n_iterations <- 100
x_matrix <- as.matrix(iris[, 1:4])
results_list <- list()
set.seed(42)
for (i in 1:n_iterations) {
sigmas <- sapply(frac_seq, function(f) {
kernlab::sigest(x = x_matrix, scaled = TRUE, frac = f)[2]
})
results_list[[i]] <- data.frame(frac = frac_seq, sigma = sigmas, iteration = i)
}
df_results <- bind_rows(results_list)
df_summary <- df_results %>%
group_by(frac) %>%
summarise(
mean_sigma = mean(sigma),
sd_sigma = sd(sigma)
)
ggplot(df_summary, aes(x = frac, y = mean_sigma)) +
geom_errorbar(aes(ymin = mean_sigma - sd_sigma, ymax = mean_sigma + sd_sigma),
width = 0.02, color = "steelblue", alpha = 0.7) +
geom_point(color = "darkblue", size = 2) +
geom_line(color = "darkblue", linetype = "dashed", alpha = 0.5) +
labs(title = "Stability of sigest Estimate",
subtitle = "Mean and Standard Deviation over 100 iterations",
x = "Fraction (frac)",
y = "Estimated Sigma (Median)") +
theme_minimal()
