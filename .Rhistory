## Sintetic dataset (two circles)
library(SVcluster)
set.seed(42)
n <- 100
theta <- seq(0, 2*pi, length.out = n)
c1_data <- cbind(cos(theta), sin(theta)) + matrix(runif(n*2, -0.1, 0.1), ncol=2)
c2_data <- cbind(2*cos(theta), 2*sin(theta)) + matrix(runif(n*2, -0.1, 0.1), ncol=2)
df_circles <- as.data.frame(rbind(c1_data, c2_data))
colnames(df_circles) <- c("c1", "c2")
results <- SVC(data = df_circles, scan_n = 10, metric = "silhouette", verbose = FALSE)
if (requireNamespace("ggplot2", quietly = TRUE)) {
library(ggplot2)
df_circles$cluster <- as.factor(results$clusters)
p <- ggplot(df_circles, aes(x = c1, y = c2, color = cluster)) +
geom_point(size = 2) +
labs(title = "SVC Results: Two Circles",
subtitle = paste("Selected Sigma:", round(results$sigma_selected, 4)),
x = "C1", y = "C2") +
theme_minimal()
print(p)
}
