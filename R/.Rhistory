library(SVC)
library(SVclust)
plot(iris[,1], iris[,2], col = SVC(iris[,1:2],scan_n=5)$clusters+1,pch=19,cex=2)
devtools::document()
devtools::check(args = c("--as-cran"))
plot(iris[,1], iris[,2], col = SVC(iris[,1:2],scan_n=10)$clusters+1,pch=19,cex=2)
plot(iris[,1], iris[,2], col = SVC(iris[,1:4],scan_n=10)$clusters+1,pch=19,cex=2)
plot(iris[,1], iris[,2], col = SVC(iris[,1:4],scan_n=5)$clusters+1,pch=19,cex=2)
